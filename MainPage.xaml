<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="LocationTracker.MainPage"
             Title="MainView">
    
    <Grid RowDefinitions="*">
        <!-- Map -->
        <maps:Map x:Name="map" 
                  IsShowingUser="True"
                  MapType="Street" />
        
        <!-- Controls Overlay -->
        <VerticalStackLayout Grid.Row="0" 
                           VerticalOptions="End"
                           Margin="20"
                           Spacing="10">
            
            <Button Text="Start Tracking" 
                    Clicked="OnStartTracking"
                    BackgroundColor="#6366F1"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    x:Name="StartButton"/>
            
            <Button Text="Stop Tracking" 
                    Clicked="OnStopTracking"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"
                    x:Name="StopButton"
                    IsEnabled="True"/>
            
            <Button Text="Clear Data" 
                    Clicked="OnClearData"
                    BackgroundColor="#64748B"
                    TextColor="White"
                    HeightRequest="50"
                    CornerRadius="10"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>